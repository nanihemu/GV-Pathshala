# ---- Server ----
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://gvpathshala:gvpathshala@localhost:5432/gvpathshala
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-too-another-long-random-string
UPLOAD_DIR=uploads
SMTP_URL=
MAIL_FROM=GV Pathshala <no-reply@gvpathshala.example>

# ---- AI (server only, never put these in the client) ----
# Leave ANTHROPIC_API_KEY empty to run without AI: the tutor then shows the closest course passage
# and the generators return a clear "AI is not configured" message.
ANTHROPIC_API_KEY=
# Choose a current model name from Anthropic's documentation
AI_MODEL=
# 'local' = built-in hashing embeddings (no key, good enough for demos). 'voyage' = Voyage AI embeddings.
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_MODEL=voyage-3
# Tune after running the AI evaluation (server/tests/ai-eval). Lower = answers more, higher = refuses more.
AI_SIMILARITY_THRESHOLD=0.25
AI_MONTHLY_TOKEN_BUDGET=2000000
AI_TUTOR_HOURLY_LIMIT=30
PSEUDONYM_SECRET=change-me-pseudonym-secret
