generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum LessonType {
  VIDEO
  READING
  QUIZ
  ASSIGNMENT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Source {
  MANUAL
  AI
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  passwordHash   String
  role           Role      @default(STUDENT)
  active         Boolean   @default(true)
  interests      String[]
  insightsOptOut Boolean   @default(false)
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())

  courses       Course[]
  enrollments   Enrollment[]
  progress      LessonProgress[]
  attempts      QuizAttempt[]
  submissions   Submission[]
  comments      Comment[]
  notifications Notification[]
  reviews       Review[]
  certificates  Certificate[]
  chats         ChatMessage[]
  dismissals    RecommendationDismissal[]
}

model Category {
  id      String   @id @default(cuid())
  name    String   @unique
  courses Course[]
}

model Course {
  id             String       @id @default(cuid())
  title          String
  description    String
  level          String       @default("Beginner")
  thumbnail      String?
  status         CourseStatus @default(DRAFT)
  aiTutorEnabled Boolean      @default(true)
  integrityMode  Boolean      @default(true)
  inviteOnly     Boolean      @default(false)
  categoryId     String
  instructorId   String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  category      Category       @relation(fields: [categoryId], references: [id])
  instructor    User           @relation(fields: [instructorId], references: [id])
  modules       Module[]
  lessons       Lesson[]
  enrollments   Enrollment[]
  reviews       Review[]
  announcements Announcement[]
  chunks        ContentChunk[]
  chats         ChatMessage[]
  certificates  Certificate[]
  insights      Insight[]
}

model Module {
  id       String   @id @default(cuid())
  courseId String
  title    String
  position Int      @default(0)
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]
}

model Lesson {
  id           String     @id @default(cuid())
  moduleId     String
  courseId     String
  title        String
  type         LessonType
  // Reading text, video transcript, or assignment brief. The AI tutor learns from this field.
  body         String     @default("")
  contentUrl   String?
  durationMin  Int        @default(5)
  position     Int        @default(0)
  // quiz settings
  passMark     Int?
  maxAttempts  Int?
  timeLimitMin Int?
  // assignment settings
  dueDate      DateTime?
  maxScore     Int?
  rubric       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  module      Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
  questions   Question[]
  attempts    QuizAttempt[]
  submissions Submission[]
  comments    Comment[]
  chunks      ContentChunk[]
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model LessonProgress {
  id           String   @id @default(cuid())
  userId       String
  lessonId     String
  completed    Boolean  @default(false)
  lastPosition Int      @default(0)
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Question {
  id             String         @id @default(cuid())
  lessonId       String
  sourceLessonId String?
  text           String
  options        Json
  correctIndex   Int
  explanation    String?
  topic          String?
  status         ApprovalStatus @default(APPROVED)
  source         Source         @default(MANUAL)
  createdAt      DateTime       @default(now())
  lesson         Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model QuizAttempt {
  id       String   @id @default(cuid())
  userId   String
  lessonId String
  // [{ questionId, choice }]
  answers  Json
  score    Int
  total    Int
  passed   Boolean
  takenAt  DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model Submission {
  id                 String            @id @default(cuid())
  userId             String
  lessonId           String
  fileUrl            String?
  fileName           String?
  textContent        String?
  late               Boolean           @default(false)
  score              Int?
  feedback           String?
  feedbackAiAssisted Boolean           @default(false)
  gradedAt           DateTime?
  submittedAt        DateTime          @default(now())
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson             Lesson            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  drafts             AiFeedbackDraft[]

  @@unique([userId, lessonId])
}

// AI feedback drafts are visible to instructors only until approved (SRS AIG-6)
model AiFeedbackDraft {
  id           String         @id @default(cuid())
  submissionId String
  strengths    String
  improvements String
  suggestedMin Int
  suggestedMax Int
  status       ApprovalStatus @default(PENDING)
  reviewedById String?
  createdAt    DateTime       @default(now())
  submission   Submission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Announcement {
  id        String   @id @default(cuid())
  courseId  String
  authorId  String
  title     String
  body      String
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Comment {
  id        String   @id @default(cuid())
  lessonId  String
  userId    String
  body      String
  createdAt DateTime @default(now())
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  text      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int
  text      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Certificate {
  id       String   @id @default(cuid())
  userId   String
  courseId String
  code     String   @unique
  issuedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// ---------- AI tables ----------

// Rows are written with raw SQL (see modules/ai/retrieval/indexer.ts) because Prisma cannot write vector columns.
model ContentChunk {
  id        String                       @id
  courseId  String
  lessonId  String
  text      String
  embedding Unsupported("vector(1024)")?
  updatedAt DateTime                     @default(now())
  course    Course                       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson    Lesson                       @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  lessonId  String?
  role      String
  text      String
  sources   Json?
  rating    Int?
  refused   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([userId, courseId, createdAt])
}

model Insight {
  id          String   @id @default(cuid())
  courseId    String?
  userId      String?
  type        String
  text        String
  evidence    Json?
  generatedAt DateTime @default(now())
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model RecommendationDismissal {
  id       String   @id @default(cuid())
  userId   String
  courseId String
  until    DateTime
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model AiUsage {
  id           String @id @default(cuid())
  month        String @unique
  inputTokens  Int    @default(0)
  outputTokens Int    @default(0)
}

// Prompts and responses, stored without personal identifiers (SRS AI-6)
model AiLog {
  id        String   @id @default(cuid())
  kind      String
  prompt    String
  response  String
  createdAt DateTime @default(now())
}

// Administrator actions (SRS ADM-5)
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  target    String?
  detail    String?
  createdAt DateTime @default(now())
}
