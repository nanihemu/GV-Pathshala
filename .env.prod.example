# Copy this file to ".env" in the project folder on the server and fill it in:   cp .env.prod.example .env
# NEVER commit the real .env file.

# ---- Database ----
# Use letters and numbers only in the password (special characters break the connection address)
POSTGRES_USER=gvpathshala
POSTGRES_PASSWORD=change-me-use-letters-and-numbers
POSTGRES_DB=gvpathshala

# ---- Address ----
# With a domain:   DOMAIN=learn.example.com   and   CLIENT_URL=https://learn.example.com
# First test by IP: leave DOMAIN empty         and   CLIENT_URL=http://YOUR_SERVER_PUBLIC_IP
DOMAIN=
CLIENT_URL=http://YOUR_SERVER_PUBLIC_IP

# ---- Secrets: make each one with   openssl rand -hex 32 ----
JWT_SECRET=
JWT_REFRESH_SECRET=
PSEUDONYM_SECRET=

# ---- Email (optional; password-reset emails are only printed in the log until this is set) ----
SMTP_URL=
MAIL_FROM=GV Pathshala <no-reply@your-domain.example>

# ---- AI (optional; the app works without it) ----
ANTHROPIC_API_KEY=
AI_MODEL=
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
